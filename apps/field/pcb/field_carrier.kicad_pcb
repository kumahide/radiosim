	(footprint "field_carrier:LED_D3.0mm-3_Horizontal_O2.54mm_Z2.0mm"
		(layer "F.Cu")
		(uuid "34d7fdd3-66cd-45b5-9f85-b19c2d3119be")
		(at 72.05 72.46)
		(descr "3 mm LED with 3 leads (OSRGHC3132A: 1 = red anode, 2 = common cathode, 3 = yellow-green anode), laid horizontal with the axis 2.0 mm above the board. Leads in one row at the datasheet pitch of 2.54 mm, bent 90 deg 2.54 mm from the flange (body toward +y) = clear of the 1.5 mm resin meniscus and of the outer leads' spread, which ends about 1.1 mm below the flange. Pads 1.5 mm so three LEDs fit at 6.8 mm pitch.")
		(tags "LED 3mm horizontal bicolor common cathode")
		(property "Reference" "D1"
